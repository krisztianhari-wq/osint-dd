# Opcionális – AI narratív összefoglalóhoz (Claude). Nélküle szabályalapú összegzés készül.
# ANTHROPIC_API_KEY=sk-ant-...
# OSINTDD_MODEL=claude-opus-5
# Opcionális – saját yente (OpenSanctions) példány URL-je (kereskedelmi használat licencköteles!)
# OSINTDD_YENTE_URL=http://localhost:8000
# Adatkönyvtár (alapértelmezés: ./data)
# OSINTDD_HOME=/Users/you/osint-dd-data
# LLM háttér kényszerítése: api | cli | ollama | rules (alapértelmezés: automatikus sorrend api → cli → ollama → rules)
# OSINTDD_LLM=cli
# Claude Code CLI modell (opcionális, pl. opus / sonnet)
# OSINTDD_CLI_MODEL=opus
# Ollama helyi modell (offline; telepítés: brew install ollama && ollama pull llama3.1)
# OSINTDD_OLLAMA_MODEL=llama3.1
# OSINTDD_OLLAMA_URL=http://127.0.0.1:11434

# ---- Szürke zónás források (ügyenként pipálva a GUI-ban) – kulcsok opcionálisak
# OSINTDD_HIBP_KEY=        # Have I Been Pwned (fizetős, ~5 USD/hó)
# OSINTDD_DEHASHED_KEY=    # DeHashed (fizetős)
# OSINTDD_INTELX_KEY=      # IntelX (ingyenes regisztráció, korlátos)
# OSINTDD_ALEPH_KEY=       # OCCRP Aleph (ingyenes fiók → Settings → API key)
